{
  "mac": {
    "groups": [
      {
        "title": "Sessions",
        "items": [
          {
            "keys": "⌘T",
            "label": "New session"
          },
          {
            "keys": "⇧⌘T",
            "label": "New session in git worktree"
          },
          {
            "keys": "⌘P",
            "label": "Duplicate session"
          },
          {
            "keys": "⇧⌘P",
            "label": "Duplicate session (choose tool)"
          },
          {
            "keys": "⌘W",
            "label": "Close session"
          },
          {
            "keys": "⌘Z",
            "label": "Reopen closed session"
          },
          {
            "keys": "⌘1–⌘9",
            "label": "Switch to session 1–9"
          },
          {
            "keys": "⌘↑↓",
            "label": "Next / previous session (grid: move between tiles)"
          },
          {
            "keys": "⌘←→",
            "label": "Grid: move between tiles — in focused mode these reach the terminal (start / end of line)"
          },
          {
            "keys": "⇧⌘↑↓",
            "label": "Reorder session within its project (wraps)"
          },
          {
            "keys": "⌃-",
            "label": "Go back to the previously visited session"
          },
          {
            "keys": "⌃⇧-",
            "label": "Go forward again"
          },
          {
            "keys": "⌘B",
            "label": "Next session needing attention (bell)"
          },
          {
            "keys": "⇧⌘B",
            "label": "Jump back to where you were"
          },
          {
            "keys": "Double-click",
            "label": "Rename (sidebar row or tile title)"
          },
          {
            "keys": "⌘-click",
            "label": "Open the file path under the cursor (programs are revealed, not run)"
          },
          {
            "keys": "⇧⌘-click",
            "label": "Open that file in your editor (Settings › Appearance)"
          }
        ]
      },
      {
        "title": "Projects",
        "items": [
          {
            "keys": "⌘N",
            "label": "New project"
          },
          {
            "keys": "⇧⌘⌫",
            "label": "Delete active project"
          },
          {
            "keys": "⌘[ / ⌘]",
            "label": "Previous / next project"
          },
          {
            "keys": "⌘E",
            "label": "Worktrees in the active project"
          },
          {
            "keys": "⌘I",
            "label": "Capture an idea"
          },
          {
            "keys": "⇧⌘I",
            "label": "Ideas in the active project"
          }
        ]
      },
      {
        "title": "View",
        "items": [
          {
            "keys": "⌘G",
            "label": "Toggle project grid"
          },
          {
            "keys": "⇧⌘G",
            "label": "Toggle all-sessions grid"
          },
          {
            "keys": "⌘↩",
            "label": "Grid: focus the active session (single view)"
          },
          {
            "keys": "⌘S",
            "label": "Toggle sidebar"
          },
          {
            "keys": "⌘J",
            "label": "Agent activity: panel (single view) / activity grid (grid)"
          },
          {
            "keys": "⇧⌘J",
            "label": "Agent activity grid"
          },
          {
            "keys": "⌘F",
            "label": "Find in session (transcript on full-screen agents)"
          },
          {
            "keys": "⌘= / ⌘- / ⌘0",
            "label": "Zoom in / out / reset"
          },
          {
            "keys": "⇧⌘K",
            "label": "Command palette"
          },
          {
            "keys": "⌘,",
            "label": "Settings (custom agents)"
          },
          {
            "keys": "⌘? or ⌘/",
            "label": "Keyboard shortcuts (this panel)"
          }
        ]
      },
      {
        "title": "Window",
        "items": [
          {
            "keys": "⇧⌘N",
            "label": "New window"
          },
          {
            "keys": "⇧⌘W",
            "label": "Close window"
          },
          {
            "keys": "⌃`",
            "label": "Open OS terminal at session directory"
          }
        ]
      },
      {
        "title": "Inside a terminal",
        "items": [
          {
            "keys": "⌃⇧C",
            "label": "Copy selection (works under mouse-tracking TUIs)"
          },
          {
            "keys": "⌃⇧V",
            "label": "Paste"
          },
          {
            "keys": "⌃⇧A",
            "label": "Select all"
          },
          {
            "keys": "⇧↩",
            "label": "Insert newline in agent input (instead of submitting)"
          },
          {
            "keys": "⌦",
            "label": "Delete the character after the cursor"
          },
          {
            "keys": "⌥⌫",
            "label": "Delete the word before the cursor"
          },
          {
            "keys": "⌥⌦",
            "label": "Delete the word after the cursor"
          },
          {
            "keys": "⌘⌫",
            "label": "Delete to start of line"
          },
          {
            "keys": "⌘⌦",
            "label": "Delete to end of line"
          },
          {
            "keys": "⌥←→",
            "label": "Move by word"
          }
        ]
      },
      {
        "title": "Ended session",
        "items": [
          {
            "keys": "↩",
            "label": "Close the session"
          },
          {
            "keys": "R",
            "label": "Restart it in place"
          },
          {
            "keys": "Esc",
            "label": "Dismiss the card, keep the tile"
          }
        ]
      },
      {
        "title": "Launcher & dialogs",
        "items": [
          {
            "keys": "1–9",
            "label": "Pick agent by number"
          },
          {
            "keys": "↑↓",
            "label": "Navigate items"
          },
          {
            "keys": "Tab",
            "label": "Next item (palette) · next field (launcher)"
          },
          {
            "keys": "↩",
            "label": "Confirm"
          },
          {
            "keys": "Esc",
            "label": "Dismiss / cancel"
          },
          {
            "keys": "←→",
            "label": "Resize sidebar (when resizer focused; ⇧ = larger steps)"
          }
        ]
      }
    ],
    "palette": {
      "new-project": "⌘N",
      "new-session": "⌘T",
      "new-session-worktree": "⇧⌘T",
      "duplicate-session": "⌘P",
