      "find-in-session": "⌘F",
      "focus-active-session": "⌘↩",
      "zoom-in": "⌘=",
      "zoom-out": "⌘-",
      "zoom-reset": "⌘0",
      "next-session": "⌘↓",
      "prev-session": "⌘↑",
      "move-forward": "⇧⌘↓",
      "move-backward": "⇧⌘↑",
      "nav-back": "⌃-",
      "nav-forward": "⌃⇧-",
      "next-attention": "⌘B",
      "jump-back": "⇧⌘B",
      "next-project": "⌘]",
