# Build output
/hive
/hivegui
/cmd/hivegui/hivegui
/hived-ws-bridge

# Wails build outputs and platform scaffolding (regenerated by `wails build`)
/cmd/hivegui/build/bin/
/cmd/hivegui/build/windows/
/cmd/hivegui/build/darwin/Info.dev.plist

# Release artifacts (uploaded to GitHub releases, not version-controlled)
/release/

# Go test artifacts
*.test
coverage.out
coverage.html

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# Agent config: local settings, per-checkout state, and the skills /
# commands / hooks that hive symlinks into each worktree. Everything here
# is local by default — settings.json is the one file we commit.
.claude/*
!.claude/settings.json
.agents/

# Screenshots (generated by VHS)
/screenshots/

# hive worktrees
.worktrees

# graphify knowledge graph (locally generated)
/graphify-out/

# hs-plan-html review-loop scratch (rendered plans + feedback server PIDs)
/.plans/

# Playwright e2e artifacts
/cmd/hivegui/frontend/test-results/

# hivesmith local tooling config
.hivesmith/

# stray daemon/gui log dumped into the repo root during debugging
/hive.log
